# App
APP_NAME=ThermaGrid API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,https://thermagrid.netlify.app

# Database
DATABASE_URL=postgresql+psycopg://heatsense:<CHANGE_ME_STRONG>@localhost:5432/heatsense
ALLOW_SQLITE_FALLBACK=true

# Operations & Risk Gates
SCHEDULER_ENABLED=false
ALLOW_SYNTHETIC_RISK=false

# Clerk (auth)
CLERK_SECRET_KEY=sk_test_<CHANGE_ME>
CLERK_JWKS_URL=https://<your-clerk-domain>/.well-known/jwks.json
CLERK_ISSUER=https://<your-clerk-domain>
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://thermagrid.netlify.app

# Resend (email)
RESEND_API_KEY=re_<CHANGE_ME>
ALERT_FROM_EMAIL=ThermaGrid <onboarding@resend.dev>

# Alerts
ALERT_PROVIDER=resend          # resend | none
ALERT_THRESHOLD=80             # risk score that triggers an alert
ALERT_COOLDOWN_MINUTES=180
ALERT_MAX_PER_DAY=2
ALERT_SEASON_BUDGET=40

# Weather
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1

# ML
MODEL_ARTIFACT_PATH=../analytics/models/forecast_model.pkl
