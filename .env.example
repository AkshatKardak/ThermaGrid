# Database (PostgreSQL + PostGIS)
POSTGRES_USER=heatsense
POSTGRES_PASSWORD=heatsensepassword
POSTGRES_DB=heatsense
POSTGRES_PORT=5432
DATABASE_URL=postgresql://heatsense:heatsensepassword@db:5432/heatsense

# Backend App Configuration
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80
ALLOW_SQLITE_FALLBACK=false
SCHEDULER_ENABLED=false
ALLOW_SYNTHETIC_RISK=true
CLERK_SECRET_KEY=dummy_secret_key
RESEND_API_KEY=dummy_resend_key

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_3D=true
